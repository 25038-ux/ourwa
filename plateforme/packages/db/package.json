{
  "name": "@elourwa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./seed-roles": "./src/seed-roles.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
