    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
