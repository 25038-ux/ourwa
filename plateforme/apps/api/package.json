{
  "name": "@elourwa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx src/auth/keygen.ts",
    "extraire-dettes": "tsx src/finance/extraire-dettes.ts"
  },
  "dependencies": {
    "tsx": "^4.19.1",
    "@elourwa/db": "workspace:*",
    "@elourwa/shared": "workspace:*",
    "@fastify/compress": "8.3.1",
    "@fastify/multipart": "9.4.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
