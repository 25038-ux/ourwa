# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://elourwa:elourwa@localhost:5432/elourwa
# Owner role used only by migrations and the cross-branch reporting job.
# NEVER used by the API request path — see standing rule 3.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/elourwa

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Mail (Mailpit in dev) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── JWT — ES256 (ECDSA P-256), standing rule 9 ──────────────────────────────
# Generate with:  pnpm --filter @elourwa/api keygen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Ports (fixed — see docs/TESTING.md) ─────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
ROOT_DOMAIN=localhost:3000

# ── La marque et le mode de déploiement (packages/shared/src/brand.ts) ──────
# Tout est facultatif ; sans rien, c'est « El Ourwa », multi-écoles, avec console.
#BRAND_NAME=El Mourad
#BRAND_NAME_AR=المراد
#BRAND_SLUG=elmourad
#BRAND_TAGLINE=Plateforme de gestion scolaire
#BRAND_MAIL_FROM=no-reply@elmourad.mr
# École unique : tout nom d'hôte désigne cette école, /platform n'existe pas.
#SINGLE_SCHOOL_SLUG=elmourad
#PLATFORM_CONSOLE=off
