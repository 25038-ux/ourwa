{
  "name": "elourwa-platform",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:rls": "pnpm --filter @elourwa/db test",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @elourwa/db seed",
    "db:migrate": "pnpm --filter @elourwa/db migrate",
    "db:reset": "pnpm --filter @elourwa/db reset",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:nuke": "docker compose -f infra/docker-compose.dev.yml down -v",
    "db:dev": "pnpm --filter @elourwa/db db:dev",
    "reconcile": "tsx tools/reconcile/run.ts",
    "importer": "tsx tools/import/run.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "fastify": "^5.12.1"
    }
  }
}
