# L'ENSEIGNE « JINAN » — un site pour UNE école, sans console de plateforme.
#
# Heavenly Private Educational Institution (جنان), Tevragh Zeina, Nouakchott.
# Chargé par `BRAND=jinan tools/packager.sh …` (application et paquets) et
# recopié dans le .env du serveur par install.sh. Chaque libellé visible du site
# et de l'application lit ces valeurs (packages/shared/src/brand.ts).
BRAND_NAME="Jinan"
BRAND_NAME_AR="جنان"
BRAND_SLUG=jinan
BRAND_TAGLINE="Plateforme de gestion scolaire"

# L'école, telle que la nomment les pages publiques /legal/… (confidentialité,
# conditions, suppression de compte) — faits donnés par le propriétaire le
# 29/09/2026 : nom, adresse, courriel, téléphone.
LEGAL_ENTITY="Heavenly Private Educational Institution (Jinan)"
LEGAL_ENTITY_AR="Heavenly Private Educational Institution (جنان)"
LEGAL_ADDRESS="465 E Nord, Tevragh Zeina, Nouakchott, Mauritanie"
LEGAL_ADDRESS_AR="465 E Nord، تفرغ زينة، نواكشوط، موريتانيا"
LEGAL_EMAIL=infoheavenly24@gmail.com
LEGAL_PHONE="+222 46 33 02 42"

# École unique : tout nom d'hôte désigne cette école ; /platform n'existe pas.
SINGLE_SCHOOL_SLUG=jinan
PLATFORM_CONSOLE=off

# L'application Android : son identifiant (distinct d'El Ourwa et d'El Mourad,
# installable à côté) et le nom sous l'icône (tools/logo_jinan.py).
APP_ID=mr.jinan.parent
APP_LABEL="Jinan"

# L'ADRESSE DU SERVEUR est compilée dans l'application : sans elle,
# `packager.sh android` refuse de construire (une application qui vise
# localhost est refusée par le Play Store). Elle s'écrit EN BAS de ce fichier
# (API_URL=https://api.<domaine>, WEB_URL=https://<domaine>) par
#   bash deploy/jinan/configurer-production.sh <ip-du-vps> <domaine>
# qui remplit aussi deploy/jinan/production.env. Puis
# `BRAND=jinan bash tools/packager.sh android`.

# Les notifications instantanées : le projet Firebase « el-mourad » (celui d'El
# Mourad et de la démonstration) sert aussi Jinan. Il y faut une application
# Android de plus, « mr.jinan.parent » (Paramètres du projet → Ajouter une
# application → Android), dont l'« ID d'application » va ici. Les trois autres
# valeurs sont celles du projet. Sans elles, l'application interroge le serveur.
#   FIREBASE_API_KEY=<celle de deploy/brands/elmourad.env>
#   FIREBASE_APP_ID=1:721820198526:android:<…>
#   FIREBASE_PROJECT_ID=el-mourad
#   FIREBASE_SENDER_ID=721820198526
