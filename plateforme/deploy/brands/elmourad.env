# L'ENSEIGNE « EL MOURAD » — un site pour UNE école, sans console de plateforme.
#
# Chargé par `BRAND=elmourad tools/packager.sh …` (application et paquets) et
# recopié dans `deploy/elmourad/.env` par `deploy/elmourad/install.sh`. Chaque
# libellé visible du site et de l'application lit ces valeurs ; rien n'est
# écrit en dur (packages/shared/src/brand.ts).
BRAND_NAME="El Mourad"
# Graphie arabe confirmée par l'école (23/09/2026).
BRAND_NAME_AR="المراد"
BRAND_SLUG=elmourad
BRAND_TAGLINE="Plateforme de gestion scolaire"
# L'expéditeur du courrier suit le domaine réel. Sur le serveur, install.sh le
# réécrit de toute façon en no-reply@<PUBLIC_DOMAIN>.
BRAND_MAIL_FROM=no-reply@elmouradarafat.cloud

# L'école, telle que la nomment les pages publiques /legal/… (confidentialité,
# conditions, suppression de compte). install.sh les recopie dans .env ; on les
# change ensuite dans .env puis `docker compose up -d web`. Pas d'adresse
# électronique : l'école n'en a pas communiqué (admin@supnum.mr est fictive et
# ne sert qu'à la première connexion) — la ligne « courriel » ne s'affiche pas.
LEGAL_ENTITY="Complexe écoles privées Elmourad"
LEGAL_ENTITY_AR="Complexe écoles privées Elmourad (المراد)"
LEGAL_PHONE="+222 27 08 89 99"
LEGAL_ADDRESS="Nouakchott, Mauritanie"
LEGAL_ADDRESS_AR="نواكشوط، موريتانيا"

# Le nom du frais annuel « photocopie » chez El Mourad (demande de l'école,
# 28/09/2026). Seul le nom affiché change — reçus, caisse, rapports.
FEE_PHOTOCOPY_LABEL="Frais Graytna"

# École unique : tout nom d'hôte désigne cette école ; /platform n'existe pas.
SINGLE_SCHOOL_SLUG=elmourad
PLATFORM_CONSOLE=off

# L'application Android : son identifiant (distinct d'El Ourwa, installable à
# côté) et le nom sous l'icône. Un identifiant distinct veut une application
# Android distincte dans le projet Firebase pour les notifications poussées.
APP_ID=mr.elmourad.parent
APP_LABEL="El Mourad"

# L'adresse du serveur, compilée dans l'application : `BRAND=elmourad
# tools/packager.sh android` la prend ici. Le domaine de l'école est
# elmouradarafat.cloud (VPS Hostinger, deploy/elmourad/install.sh).
# ⚠ Une construction sans API_URL démarre sur localhost : refusée par le Play
# Store (l'examinateur ne peut pas se connecter). packager.sh `android` l'exige.
API_URL=https://api.elmouradarafat.cloud
WEB_URL=https://elmouradarafat.cloud

# Les notifications instantanées (docs/FIREBASE.md, étape 3) : les quatre valeurs
# de l'application Android « mr.elmourad.parent » du projet Firebase. Sans elles,
# l'application interroge le serveur (15 s ouverte, 15 min fermée).
FIREBASE_API_KEY=AIzaSyBeLgsvkSkXOSAQ9PCZKCpUq-216pECDPQ
FIREBASE_APP_ID=1:721820198526:android:e09a33ba885d11001d9a2f
FIREBASE_PROJECT_ID=el-mourad
FIREBASE_SENDER_ID=721820198526
