# JINAN — trois noms, un domaine : le site sur l'apex et `www.`, l'API
# (l'application des familles) sur `api.`. Les certificats viennent de Let's
# Encrypt, un par nom ; le DNS doit pointer les trois vers ce serveur AVANT
# le premier démarrage (sinon Caddy réessaie, sans dommage, jusqu'à ce qu'ils
# y pointent).
# L'adresse de contact ACME (Let's Encrypt). ⚠ Elle ne doit JAMAIS être vide :
# « email » sans valeur est une erreur de syntaxe et Caddy ne démarre pas.
# install.sh refuse donc de continuer sans ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

api.{$PUBLIC_DOMAIN} {
	# L'application des familles arrive ici directement : Caddy dit à l'API qui
	# est devant l'écran (l'API ne lit pas X-Forwarded-For, trop facile à forger,
	# seulement X-Client-IP d'un mandataire de confiance — TRUSTED_PROXIES).
	reverse_proxy api:3001 {
		header_up X-Client-IP {remote_host}
		header_up X-Client-User-Agent {header.User-Agent}
	}
	encode zstd gzip
}

{$PUBLIC_DOMAIN}, www.{$PUBLIC_DOMAIN} {
	# ⚠ LES FEUILLES DE STYLE REPRISES NE SE REDEMANDENT PLUS À CHAQUE PAGE (10/10/2026).
	# Chaque clic du site recharge la page entière, et les sept feuilles de
	# /elourwa/ partaient avec « max-age=0 » : le navigateur revérifiait chacune
	# auprès du serveur avant de dessiner quoi que ce soit — un aller-retour
	# vers l'Europe par page, mesuré à 340 ms depuis Nouakchott sur une bonne
	# ligne, bien plus sur une mauvaise. Leur adresse porte « ?v=<construction> »
	# (VERSION_FEUILLES, next.config.mjs), qui change à chaque construction :
	# une adresse donnée ne changera donc jamais de contenu, et peut être gardée
	# un an. Sans « ?v= » rien n'est changé. « defer » : posé APRÈS la réponse
	# du site, sinon son « max-age=0 » l'emporterait.
	@feuilles {
		path /elourwa/*
		query v=*
	}
	header @feuilles {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	# École unique : quel que soit le nom, c'est cette école (SINGLE_SCHOOL_SLUG).
	reverse_proxy web:3000
	encode zstd gzip

	# Le journal des requêtes du site : la durée, le code et la taille de chaque
	# réponse — ce qui a manqué le 10/10 pour dire ce que « c'est lent » voulait
	# dire. ⚠ NI en-têtes, NI paramètres : une recherche porte un nom de famille
	# dans son adresse, et ce journal ne doit en garder aucun. Tourné par Docker
	# (10 Mo × 5, comme les autres services).
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}

# Les AUTRES sites de ce serveur, chacun sur son propre domaine — aujourd'hui le
# site vitrine (vitrine/, VITRINE_DOMAIN dans .env), sans aucun lien avec
# l'application. install.sh écrit leurs blocs dans caddy-sites/ ; aucun
# fichier : aucun site, et la configuration reste valide.
import /etc/caddy/sites/*.caddy
