# Copy to .env. Never commit real secrets. In prod, inject these from a secret manager.
FORSA_ENV=dev
# The app role must NOT be a superuser (superusers bypass row-level security).
FORSA_DATABASE_URL=postgresql+psycopg://forsa:forsa@db:5432/forsa
# Required in prod (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
FORSA_JWT_SECRET=change-me-dev-only
FORSA_COOKIE_SECURE=false
FORSA_CORS_ORIGINS=["http://localhost:3000"]
FORSA_STORAGE_DIR=/data/storage
# Synthetic demo notices are dated relative to this fixed day; bump it to refresh the demo.
FORSA_DEMO_ANCHOR=2026-09-21
# ── AI (all optional — FORSA is fully functional and deterministic without any provider) ──────────────
# Ordered provider ids from backend/src/forsa/ai/catalog.yaml (comma list or JSON array). A provider is used
# only if it is listed here (or enabled by a platform admin in Settings → AI providers) AND has a key.
# Examples: jev,deepseek,groq   |   ollama   |   anthropic,openai
FORSA_AI_PROVIDERS=
FORSA_AI_DAILY_BUDGET_USD_PER_ORG=2.0
# Keys: each provider reads its catalog env var (below), or FORSA_<ID>_API_KEY, or FORSA_AI_KEY_<ID>.
# Put them in your secret manager / environment secrets — never in the database or in git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=        # Qwen (Alibaba Cloud Model Studio)
MOONSHOT_API_KEY=         # Kimi
ZHIPU_API_KEY=            # GLM
MINIMAX_API_KEY=
NVIDIA_API_KEY=           # NVIDIA NIM (build.nvidia.com)
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=                 # Hugging Face inference providers
TYPESAFE_API_KEY=         # Jev (TypeSafe System One decision model)
# Local models (data never leaves your servers; allowed up to CONFIDENTIAL data):
OLLAMA_BASE_URL=          # e.g. http://ollama:11434/v1
# AI features (comma list): ai_explanations, ai_extraction, ai_decisions, ai_triage, ai_drafting
FORSA_FEATURES=
# Deprecated single-provider switch (still honoured when FORSA_AI_PROVIDERS is empty):
FORSA_AI_PROVIDER=none

# ── Web Push (optional; `pip install forsa[push]`) ──────────────────────────────────────────────────────
# Generate once: backend/.venv/bin/forsa vapid-keys  (or any VAPID generator). Private key = secret.
FORSA_VAPID_PUBLIC_KEY=
FORSA_VAPID_PRIVATE_KEY=
FORSA_VAPID_SUBJECT=mailto:ops@example.com
