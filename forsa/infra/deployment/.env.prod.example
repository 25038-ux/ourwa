# ── Required ─────────────────────────────────────────────────────────────────────────────────────────────
FORSA_DOMAIN=forsa.example.mr          # DNS A/AAAA record must point to this server
ACME_EMAIL=ops@example.mr              # Let's Encrypt account e-mail
# Generated by deploy.sh on first run (keep them secret, keep a copy offline):
FORSA_JWT_SECRET=
POSTGRES_ADMIN_PASSWORD=
FORSA_DB_PASSWORD=
FORSA_VAPID_PUBLIC_KEY=
FORSA_VAPID_PRIVATE_KEY=
FORSA_VAPID_SUBJECT=mailto:ops@example.mr

# ── Android app (Trusted Web Activity) ───────────────────────────────────────────────────────────────────
# SHA-256 of the certificate that signs the installed APK (comma list). For Play Store builds add the
# "App signing key certificate" fingerprint from Play Console → Setup → App integrity.
FORSA_ANDROID_PACKAGE=mr.forsa.app
FORSA_ANDROID_SHA256=
# Public privacy page (/privacy): who operates this server and the contact for personal-data requests.
FORSA_OPERATOR_NAME=
FORSA_PRIVACY_CONTACT=

# ── AI (optional; FORSA works fully without any provider) ────────────────────────────────────────────────
FORSA_AI_PROVIDERS=
FORSA_FEATURES=
FORSA_AI_DAILY_BUDGET_USD_PER_ORG=2.0
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Sources ──────────────────────────────────────────────────────────────────────────────────────────────
# UNGM Notice API (issued by the UNGM Secretariat — eprocurement@ungm.org). Without them UNGM shows AUTH_REQUIRED.
UNGM_CLIENT_ID=
UNGM_CLIENT_SECRET=
UNGM_REFRESH_TOKEN=

# ── Tuning ───────────────────────────────────────────────────────────────────────────────────────────────
FORSA_OCR_ENABLED=true
FORSA_OCR_LANGS=fra+ara
BACKUP_KEEP_DAYS=14
