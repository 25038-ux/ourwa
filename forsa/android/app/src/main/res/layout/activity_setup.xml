<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/forsa_deep" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp"
        android:minHeight="600dp">

        <ImageView android:id="@+id/logo" android:layout_width="84dp" android:layout_height="84dp"
            android:src="@mipmap/ic_launcher" android:contentDescription="@string/app_name" />

        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/setup_title" android:textColor="#FFFFFF"
            android:textSize="32sp" android:textStyle="bold" android:letterSpacing="-0.02" />

        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/setup_subtitle" android:textColor="#B8D8CF"
            android:textSize="16sp" android:lineSpacingExtra="4dp" />

        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="32dp" android:background="@drawable/field" android:hint="@string/setup_hint"
            android:importantForAutofill="no" android:inputType="textUri" android:paddingHorizontal="18dp"
            android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#6FA395" android:textSize="16sp"
            android:imeOptions="actionGo" />

        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="#FF9B8F" android:textSize="14sp" android:visibility="gone" />

        <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="20dp" android:background="@drawable/button" android:text="@string/setup_continue"
            android:textAllCaps="false" android:textColor="#04130E" android:textSize="16sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:text="@string/setup_footer" android:textColor="#6FA395" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
