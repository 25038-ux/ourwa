<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Forsa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/forsa_accent</item>
        <item name="android:colorPrimary">@color/forsa_accent</item>
        <item name="android:windowBackground">@color/forsa_bg</item>
        <item name="android:statusBarColor">@color/forsa_bg</item>
        <item name="android:navigationBarColor">@color/forsa_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Forsa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forsa_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Forsa</item>
    </style>
</resources>
